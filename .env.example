# Copia este archivo a ".env" y completa los valores

# Organización de Azure DevOps (nombre de la org, sin https://)
AZURE_DEVOPS_ORG=tu-organizacion

# Proyecto de Azure DevOps (nombre del proyecto)
AZURE_DEVOPS_PROJECT=Tu-Proyecto

# Personal Access Token (permisos mínimo: Work Items -> Read & Write)
AZURE_DEVOPS_PAT=tu_pat_aqui

# Modelo de Ollama (por defecto qwen2.5:7b-instruct)
OLLAMA_MODEL=qwen2.5:7b-instruct

# Temperatura y tokens máximos para el modelo
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=8192