# ============================================================
# COPIA ESTE ARCHIVO A ".env" Y REEMPLAZA LOS VALORES
# Copiar:   Copy-Item .env.example .env
# Editar:   con el Bloc de notas o tu editor favorito
#
# NOTA: mientras los 3 valores de Azure sigan como plantilla
# (tu-organizacion / Tu-Proyecto / tu_pat_aqui), la app corre en
# MODO DEMO y NO crea nada en Azure DevOps.
# ============================================================

# ============================================================
# 1) ORGANIZACIÓN
#    Es lo que aparece en https://dev.azure.com/<ESTO>
#    Ejemplo: si entras a https://dev.azure.com/miempresa
#    entonces -> AZURE_DEVOPS_ORG=miempresa   (sin https://)
# ============================================================
AZURE_DEVOPS_ORG=tu-organizacion

# ============================================================
# 2) PROYECTO
#    Nombre EXACTO del proyecto (tal cual sale en el portal).
#    Ejemplo: AZURE_DEVOPS_PROJECT=Proyecto QA
# ============================================================
AZURE_DEVOPS_PROJECT=Tu-Proyecto

# ============================================================
# 3) PAT (Personal Access Token)
#    Cómo crearlo en Azure DevOps:
#      a) Entra a https://dev.azure.com/<tu-org>/_usersSettings/tokens
#      b) + New Token  ->  Name: "qa-testcase-generator"
#      c) Organization: tu organización
#      d) Scopes: "Work Items" -> marcar "Read & Write"
#      e) Expiration: 30 o 90 días
#      f) Create -> COPIA el token (solo se muestra una vez)
#    Pega ese token aquí (sin comillas, sin espacios):
# ============================================================
AZURE_DEVOPS_PAT=tu_pat_aqui

# ============================================================
# MODELO DE OLLAMA
# qwen2.5:7b-instruct  -> recomendado (~4.7 GB)
# qwen2.5:3b-instruct  -> más rápido (~2 GB), algo menos calidad
# ============================================================
OLLAMA_MODEL=qwen2.5:7b-instruct

# Temperatura (0.2 = determinista) y tokens máximos de salida
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=8192