FROM ollama/ollama:latest

USER root

# Certificados corporativos (Netskope) — opcional: si backend/ca/netskope-root.crt existe se instala
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY ca /ca
RUN if [ -f /ca/netskope-root.crt ]; then \
      cp /ca/netskope-root.crt /usr/local/share/ca-certificates/netskope-root.crt && \
      cp /ca/netskope-intermediate.crt /usr/local/share/ca-certificates/netskope-intermediate.crt && \
      update-ca-certificates; \
    fi

# OpenSSL/Go de Ollama usan este bundle del sistema
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Auto-descarga del modelo al iniciar (idempotente)
# sed elimina CRLF por si el archivo se clonó con fin de línea de Windows
COPY entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]